# Supabase project connection string (Settings -> Database -> Connection string
# -> "Transaction" pooler mode is fine for this worker's usage pattern).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role key -- server-side only, never expose to the browser

# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
